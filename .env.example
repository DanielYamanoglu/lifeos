# Copy to .env. All values are placeholders.
# Leave NEO4J_URI / QDRANT_URL unset to use the in-memory stores (no Docker needed).
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=changeme-local
QDRANT_URL=http://localhost:6333
# hashing (offline, deterministic) | minilm | auto (minilm, falling back to hashing)
LIFEOS_EMBEDDER=auto
# Only needed for the real LLM; the demo uses an offline stub without it.
ANTHROPIC_API_KEY=your-api-key-here
LIFEOS_MODEL=claude-sonnet-5-5
